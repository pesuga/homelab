  "validation_rules": {
    "response_time_thresholds": {
      "fast_ms": 200,
      "medium_ms": 1000,
      "slow_ms": 5000
    },
    "resource_thresholds": {
      "cpu_warning": 70,
      "cpu_critical": 90,
      "memory_warning": 70,
      "memory_critical": 90,
      "disk_warning": 80,
      "disk_critical": 95
    },
    "gpu_thresholds": {
      "memory_warning": 12,
      "memory_critical": 15,
      "utilization_warning": 80,
      "utilization_critical": 95
    },
    "kubernetes_health": {
      "min_ready_pods": 1,
      "max_restart_count": 5,
      "pending_timeout_seconds": 300
    }
  },
  "troubleshooting_playbooks": {
    "service_down": [
      "Check pod status: kubectl get pods -n <namespace> -l app=<service>",
      "Check service status: kubectl get svc -n <namespace> <service>",
      "Check logs: kubectl logs -n <namespace> -l app=<service> --tail=20",
      "Restart deployment: kubectl rollout restart deployment/<service> -n <namespace>",
      "Verify endpoints: kubectl get endpoints -n <namespace> <service>"
    ],
    "slow_response": [
      "Check resource usage: kubectl top pods -n <namespace>",
      "Check pod events: kubectl describe pod <pod-name> -n <namespace>",
      "Check network latency: ping <service-ip>",
      "Check node resources: kubectl top nodes",
      "Review application logs for performance issues"
    ],
    "connection_refused": [
      "Verify service exists: kubectl get svc -n <namespace>",
      "Check port mapping: kubectl describe svc <service> -n <namespace>",
      "Check pod is ready: kubectl get pods -n <namespace>",
      "Test network policies: kubectl get networkpolicies -n <namespace>",
      "Check firewall rules on nodes"
    ],
    "gpu_not_detected": [
      "Check GPU hardware: rocminfo",
      "Check ROCm installation: rocm-smi",
      "Check kernel modules: lsmod | grep amdgpu",
      "Verify Ollama GPU access: curl http://localhost:11434/api/version",
      "Restart Ollama with GPU: systemctl restart ollama"
    ]
  },
  "monitoring_endpoints": {
